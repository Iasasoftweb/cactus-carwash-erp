{
  "name": "cactus-carwash-erp",
  "version": "1.9.1",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @cactus/database prisma:generate",
    "db:migrate": "pnpm --filter @cactus/database prisma:migrate",
    "db:seed": "pnpm --filter @cactus/database prisma:seed",
    "check": "pnpm db:generate && pnpm --filter @cactus/database build && pnpm --filter @cactus/shared typecheck && pnpm --filter @cactus/ui typecheck && pnpm --filter @cactus/api typecheck && pnpm --filter @cactus/web typecheck",
    "dev:api": "pnpm --filter @cactus/api dev",
    "dev:web": "pnpm --filter @cactus/web dev"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
