  pointOfSaleId String              @map("point_of_sale_id") @db.Char(36)
  accountId     String              @map("account_id") @db.Char(36)
  ticketNumber  String              @map("ticket_number") @db.VarChar(50)
  status        KitchenTicketStatus @default(PENDING)
  notes         String?             @db.VarChar(255)
  sentAt        DateTime            @default(now()) @map("sent_at")
  startedAt     DateTime?           @map("started_at")
  readyAt       DateTime?           @map("ready_at")
  completedAt   DateTime?           @map("completed_at")
  cancelledAt   DateTime?           @map("cancelled_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  pointOfSale PointOfSale         @relation(fields: [pointOfSaleId], references: [id])
  account     PosAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items       KitchenTicketItem[]

  @@unique([pointOfSaleId, ticketNumber])
  @@index([pointOfSaleId, status, sentAt])
  @@index([accountId, sentAt])
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id                 String                  @id @default(uuid()) @db.Char(36)
  ticketId           String                  @map("ticket_id") @db.Char(36)
  accountItemId      String                  @map("account_item_id") @db.Char(36)
  quantity           Decimal                 @db.Decimal(12, 3)
  status             KitchenTicketItemStatus @default(PENDING)
  notes              String?                 @db.VarChar(255)
  cancellationReason String?                 @map("cancellation_reason") @db.VarChar(255)
  cancelledAt        DateTime?               @map("cancelled_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  ticket      KitchenTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  accountItem PosAccountItem @relation(fields: [accountItemId], references: [id])

  @@unique([ticketId, accountItemId])
  @@index([accountItemId])
  @@index([ticketId, status])
  @@map("kitchen_ticket_items")
}

model PosAccount {
  id                  String           @id @default(uuid()) @db.Char(36)
  pointOfSaleId       String           @map("point_of_sale_id") @db.Char(36)
  cashRegisterId      String?          @map("cash_register_id") @db.Char(36)
  orderId             String?          @map("order_id") @db.Char(36)
  customerId          String?          @map("customer_id") @db.Char(36)
  priceLevelId        String?          @map("price_level_id") @db.Char(36)
  priceLevelCode      String?          @map("price_level_code") @db.VarChar(40)
  priceLevelName      String?          @map("price_level_name") @db.VarChar(120)
  reference           String           @unique @db.VarChar(50)
  customerAlias       String           @map("customer_alias") @db.VarChar(160)
  tableReference      String?          @map("table_reference") @db.VarChar(50)
  status              PosAccountStatus @default(OPEN)
  saleMode            PosSaleMode      @default(DIRECT) @map("sale_mode")
  subtotal            Decimal          @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal          @default(0) @map("tax_amount") @db.Decimal(14, 2)
  serviceChargeRate   Decimal          @default(0) @map("service_charge_rate") @db.Decimal(7, 4)
  serviceChargeAmount Decimal          @default(0) @map("service_charge_amount") @db.Decimal(14, 2)
  total               Decimal          @default(0) @db.Decimal(14, 2)
  openedAt            DateTime         @default(now()) @map("opened_at")
  paidAt              DateTime?        @map("paid_at")
  closedAt            DateTime?        @map("closed_at")
  paymentMethodId     String?          @map("payment_method_id") @db.Char(36)
  paymentReference    String?          @map("payment_reference") @db.VarChar(120)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  pointOfSale    PointOfSale      @relation(fields: [pointOfSaleId], references: [id])
  cashRegister   CashRegister?    @relation(fields: [cashRegisterId], references: [id])
  order          ServiceOrder?    @relation(fields: [orderId], references: [id])
  paymentMethod  PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  priceLevel     PriceLevel?      @relation(fields: [priceLevelId], references: [id], onDelete: SetNull)
  items          PosAccountItem[]
  kitchenTickets KitchenTicket[]

  @@index([pointOfSaleId, status, openedAt])
  @@index([orderId, status])
  @@index([customerId, status])
  @@index([priceLevelId])
  @@map("pos_accounts")
}

model PosAccountItem {
  id                  String   @id @default(uuid()) @db.Char(36)
  accountId           String   @map("account_id") @db.Char(36)
  productId           String   @map("product_id") @db.Char(36)
  quantity            Decimal  @db.Decimal(12, 3)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(14, 2)
  standardUnitPrice   Decimal  @map("standard_unit_price") @db.Decimal(14, 2)
  priceLevelCode      String?  @map("price_level_code") @db.VarChar(40)
  priceLevelName      String?  @map("price_level_name") @db.VarChar(120)
  manualPriceOverride Boolean  @default(false) @map("manual_price_override")
  priceOverrideReason String?  @map("price_override_reason") @db.VarChar(255)
  unitCost            Decimal? @map("unit_cost") @db.Decimal(14, 4)
  costTotal           Decimal? @map("cost_total") @db.Decimal(14, 2)
  taxRate             Decimal  @default(0) @map("tax_rate") @db.Decimal(7, 4)
  taxAmount           Decimal  @map("tax_amount") @db.Decimal(14, 2)
  lineTotal           Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  account            PosAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  kitchenTicketItems KitchenTicketItem[]

  @@index([accountId, createdAt])
  @@map("pos_account_items")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  ISSUED
  CANCELLED
}

model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Char(36)
  companyId String   @map("company_id") @db.Char(36)
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  expenses Expense[]

  @@unique([companyId, code])
  @@map("expense_categories")
}

model Expense {
  id             String        @id @default(uuid()) @db.Char(36)
  companyId      String        @map("company_id") @db.Char(36)
  branchId       String        @map("branch_id") @db.Char(36)
  categoryId     String        @map("category_id") @db.Char(36)
  cashRegisterId String        @map("cash_register_id") @db.Char(36)
  cashSessionId  String?       @map("cash_session_id") @db.Char(36)
  requestedById  String        @map("requested_by_id") @db.Char(36)
  beneficiary    String        @db.VarChar(160)
  concept        String        @db.VarChar(255)
  amount         Decimal       @db.Decimal(14, 2)
  reference      String?       @db.VarChar(120)
  status         ExpenseStatus @default(PENDING)
  approvedAt     DateTime?     @map("approved_at")
  issuedAt       DateTime?     @map("issued_at")
  cancelledAt    DateTime?     @map("cancelled_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  company      Company         @relation(fields: [companyId], references: [id])
  branch       Branch          @relation(fields: [branchId], references: [id])
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  cashRegister CashRegister    @relation(fields: [cashRegisterId], references: [id])
  cashSession  CashSession?    @relation(fields: [cashSessionId], references: [id])
  requestedBy  Employee        @relation(fields: [requestedById], references: [id])

  @@index([branchId, status, createdAt])
  @@index([cashRegisterId, status])
  @@map("expenses")
}

model CashPrintLog {
  id            String   @id @default(uuid()) @db.Char(36)
  cashSessionId String   @map("cash_session_id") @db.Char(36)
  documentType  String   @map("document_type") @db.VarChar(40)
  reprint       Boolean  @default(false)
  printedBy     String   @map("printed_by") @db.VarChar(160)
  printedAt     DateTime @default(now()) @map("printed_at")

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])

  @@index([cashSessionId, documentType, printedAt])
  @@map("cash_print_logs")
}

model Supplier {
  id        String            @id @default(uuid()) @db.Char(36)
  companyId String            @map("company_id") @db.Char(36)
  name      String            @db.VarChar(160)
  taxId     String?           @map("tax_id") @db.VarChar(50)
  phone     String?           @db.VarChar(30)
  email     String?           @db.VarChar(180)
  address   String?           @db.VarChar(255)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  invoices  SupplierInvoice[]
  payments  SupplierPayment[]

  company        Company         @relation(fields: [companyId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([companyId, active])
  @@index([companyId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Char(36)
  companyId   String              @map("company_id") @db.Char(36)
  branchId    String              @map("branch_id") @db.Char(36)
  supplierId  String              @map("supplier_id") @db.Char(36)
  orderNumber String              @map("order_number") @db.VarChar(50)
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?             @db.VarChar(255)
  createdBy   String?             @map("created_by") @db.VarChar(160)
  orderedAt   DateTime?           @map("ordered_at")
  receivedAt  DateTime?           @map("received_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  company          Company             @relation(fields: [companyId], references: [id])
  branch           Branch              @relation(fields: [branchId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]
  supplierInvoices SupplierInvoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId, branchId, status])
  @@index([supplierId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid()) @db.Char(36)
  purchaseOrderId  String  @map("purchase_order_id") @db.Char(36)
  productId        String  @map("product_id") @db.Char(36)
  quantity         Decimal @db.Decimal(14, 3)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)
  unitCost         Decimal @map("unit_cost") @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

model SupplierInvoice {
  id              String  @id @default(uuid()) @db.Char(36)
  companyId       String  @map("company_id") @db.Char(36)
  branchId        String  @map("branch_id") @db.Char(36)
  supplierId      String  @map("supplier_id") @db.Char(36)
  purchaseOrderId String? @map("purchase_order_id") @db.Char(36)

  invoiceNumber String                @map("invoice_number") @db.VarChar(80)
  status        SupplierInvoiceStatus @default(PENDING)

  subtotal  Decimal @db.Decimal(14, 2)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total     Decimal @db.Decimal(14, 2)
  balance   Decimal @db.Decimal(14, 2)

  issuedAt DateTime  @map("issued_at")
  dueDate  DateTime? @map("due_date")

  notes     String? @db.VarChar(255)
  createdBy String? @map("created_by") @db.VarChar(160)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  allocations   SupplierPaymentAllocation[]
  pointOfSale   PointOfSale?                @relation(fields: [pointOfSaleId], references: [id])
  pointOfSaleId String?                     @db.Char(36)

  @@unique([supplierId, invoiceNumber])
  @@index([companyId, branchId, status])
  @@index([supplierId, status, dueDate])
  @@index([purchaseOrderId])
  @@map("supplier_invoices")
}

model SupplierPayment {
  id              String @id @default(uuid()) @db.Char(36)
  companyId       String @map("company_id") @db.Char(36)
  branchId        String @map("branch_id") @db.Char(36)
  supplierId      String @map("supplier_id") @db.Char(36)
  paymentMethodId String @map("payment_method_id") @db.Char(36)

  status SupplierPaymentStatus @default(ISSUED)

  reference   String? @db.VarChar(120)
  description String? @db.VarChar(255)

  amount Decimal @db.Decimal(14, 2)

  paidAt    DateTime @default(now()) @map("paid_at")
  createdBy String?  @map("created_by") @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")

  company  Company       @relation(fields: [companyId], references: [id])
  branch   Branch        @relation(fields: [branchId], references: [id])
  supplier Supplier      @relation(fields: [supplierId], references: [id])
  method   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  allocations   SupplierPaymentAllocation[]
  pointOfSale   PointOfSale?                @relation(fields: [pointOfSaleId], references: [id])
  pointOfSaleId String?                     @db.Char(36)

  @@index([companyId, branchId, paidAt])
  @@index([supplierId, paidAt])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  supplierPaymentId String  @map("supplier_payment_id") @db.Char(36)
  supplierInvoiceId String  @map("supplier_invoice_id") @db.Char(36)
  amount            Decimal @db.Decimal(14, 2)

  payment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id])

  @@id([supplierPaymentId, supplierInvoiceId])
  @@index([supplierInvoiceId])
  @@map("supplier_payment_allocations")
}

model CompanyModule {
  id        String             @id @default(uuid()) @db.Char(36)
  companyId String             @map("company_id") @db.Char(36)
  module    BusinessModuleType
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, module])
  @@index([companyId, enabled])
  @@map("company_modules")
}

model ProductBranch {
  id             String   @id @default(uuid()) @db.Char(36)
  companyId      String   @map("company_id") @db.Char(36)
  branchId       String   @map("branch_id") @db.Char(36)
  productId      String   @map("product_id") @db.Char(36)
  categoryId     String   @map("category_id") @db.Char(36)
  price          Decimal  @db.Decimal(14, 2)
  minimumPrice   Decimal? @map("minimum_price") @db.Decimal(14, 2)
  unitCost       Decimal? @map("unit_cost") @db.Decimal(14, 4)
  stockQuantity  Decimal  @default(0) @map("stock_quantity") @db.Decimal(14, 3)
  minimumStock   Decimal  @default(0) @map("minimum_stock") @db.Decimal(14, 3)
  trackInventory Boolean  @default(true) @map("track_inventory")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  category            ProductCategory      @relation(fields: [categoryId], references: [id])
  pointOfSales        ProductPointOfSale[]
  levelPrices         ProductBranchPrice[]
  inventoryCountItems InventoryCountItem[]

  @@unique([productId, branchId])
  @@index([companyId, branchId, active])
  @@index([categoryId, active])
  @@map("product_branches")
}

model InventoryCount {
  id          String               @id @default(uuid()) @db.Char(36)
  companyId   String               @map("company_id") @db.Char(36)
  branchId    String               @map("branch_id") @db.Char(36)
  reference   String               @db.VarChar(50)
  status      InventoryCountStatus @default(DRAFT)
  notes       String?              @db.VarChar(255)
  createdBy   String               @map("created_by") @db.VarChar(160)
  confirmedBy String?              @map("confirmed_by") @db.VarChar(160)
  confirmedAt DateTime?            @map("confirmed_at")
  cancelledAt DateTime?            @map("cancelled_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch               @relation(fields: [branchId], references: [id])
  items   InventoryCountItem[]

  @@unique([companyId, reference])
  @@index([companyId, branchId, status, createdAt])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id                 String   @id @default(uuid()) @db.Char(36)
  inventoryCountId   String   @map("inventory_count_id") @db.Char(36)
  productBranchId    String   @map("product_branch_id") @db.Char(36)
  expectedQuantity   Decimal  @map("expected_quantity") @db.Decimal(14, 3)
  countedQuantity    Decimal? @map("counted_quantity") @db.Decimal(14, 3)
  differenceQuantity Decimal? @map("difference_quantity") @db.Decimal(14, 3)
  unitCost           Decimal? @map("unit_cost") @db.Decimal(14, 4)
  differenceValue    Decimal? @map("difference_value") @db.Decimal(16, 2)
  note               String?  @db.VarChar(255)
  updatedAt          DateTime @updatedAt @map("updated_at")

  inventoryCount InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productBranch  ProductBranch  @relation(fields: [productBranchId], references: [id])

  @@unique([inventoryCountId, productBranchId])
  @@index([productBranchId])
  @@map("inventory_count_items")
}

model ProductPointOfSale {
  id                   String   @id @default(uuid()) @db.Char(36)
  productBranchId      String   @map("product_branch_id") @db.Char(36)
  pointOfSaleId        String   @map("point_of_sale_id") @db.Char(36)
  preparationStationId String?  @map("preparation_station_id") @db.Char(36)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  productBranch      ProductBranch       @relation(fields: [productBranchId], references: [id], onDelete: Cascade)
  pointOfSale        PointOfSale         @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)
  preparationStation PreparationStation? @relation(fields: [preparationStationId], references: [id], onDelete: SetNull)

  @@unique([productBranchId, pointOfSaleId])
  @@index([pointOfSaleId, active])
  @@index([preparationStationId, active])
  @@map("product_points_of_sale")
}

model PriceLevel {
  id        String   @id @default(uuid()) @db.Char(36)
  companyId String   @map("company_id") @db.Char(36)
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(120)
  isDefault Boolean  @default(false) @map("is_default")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers     Customer[]
  productPrices ProductBranchPrice[]
  posAccounts   PosAccount[]
  posMovements  PosMovement[]

  @@unique([companyId, code])
  @@index([companyId, active, sortOrder])
  @@map("price_levels")
}

model ProductBranchPrice {
  id              String   @id @default(uuid()) @db.Char(36)
  companyId       String   @map("company_id") @db.Char(36)
  productBranchId String   @map("product_branch_id") @db.Char(36)
  priceLevelId    String   @map("price_level_id") @db.Char(36)
  price           Decimal  @db.Decimal(14, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productBranch ProductBranch @relation(fields: [productBranchId], references: [id], onDelete: Cascade)
  priceLevel    PriceLevel    @relation(fields: [priceLevelId], references: [id], onDelete: Cascade)

  @@unique([productBranchId, priceLevelId])
  @@index([companyId, active])
  @@index([priceLevelId, active])
  @@map("product_branch_prices")
}
