generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum CustomerType {
  GENERAL
  REGISTERED
  CREDIT
}

enum CommissionType {
  PERCENTAGE
  FIXED_AMOUNT
  NONE
}

enum OrderOperationalStatus {
  RECEIVED
  WAITING
  IN_PROGRESS
  SERVICES_COMPLETED
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderFinancialStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CREDIT
  CREDIT_NOTE_APPLIED
}

enum CreditNoteStatus {
  ISSUED
  CANCELLED
}

enum OrderItemType {
  SERVICE
  PRODUCT
}

enum PurchaseOrderStatus {
  DRAFT
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  COMPLETED
  VOIDED
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  CREDIT
  CREDIT_NOTED
}

enum PaymentMethodType {
  CASH
  CARD
  TRANSFER
  CREDIT
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE
  COLLECTION
  CREDIT_SALE
  EXPENSE
  WITHDRAWAL
  DEPOSIT
  ADJUSTMENT
  CLOSING
}

enum CreditAuthorizationStatus {
  APPROVED
  CANCELLED
}

enum BusinessModuleType {
  POS
  CAR_WASH
  INVENTORY
  PURCHASES
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  EXPENSES
}

enum PosCapabilityType {
  RETAIL
  FOOD_SERVICE
  WEIGHTED_PRODUCTS
  HOLD_ORDERS
  TABLES
  KITCHEN_TICKETS
  DELIVERY
}

enum ProductSaleUnit {
  UNIT
  WEIGHT
  VOLUME
  SERVICE
}

model Company {
  id             String   @id @default(uuid()) @db.Char(36)
  name           String   @db.VarChar(160)
  legalName      String?  @map("legal_name") @db.VarChar(200)
  taxId          String?  @map("tax_id") @db.VarChar(50)
  currencyCode   String   @default("DOP") @map("currency_code") @db.Char(3)
  currencySymbol String   @default("RD$") @map("currency_symbol") @db.VarChar(8)
  logoUrl        String?  @map("logo_url") @db.VarChar(500)
  branchLimit    Int      @default(1) @map("branch_limit")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  branches            Branch[]
  users               User[]
  customers           Customer[]
  employees           Employee[]
  services            Service[]
  serviceCategories   ServiceCategory[]
  operationalAreas    OperationalArea[]
  pointsOfSale        PointOfSale[]
  productCategories   ProductCategory[]
  products            Product[]
  inventoryMovements  InventoryMovement[]
  inventoryCounts     InventoryCount[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  modules             CompanyModule[]
  branchModules       BranchModule[]
  productBranches     ProductBranch[]
  priceLevels         PriceLevel[]
  productBranchPrices ProductBranchPrice[]

  expenseCategories ExpenseCategory[]
  expenses          Expense[]

  creditNotes          CreditNote[]
  collectionActivities CustomerCollectionActivity[]

  auditLogs        AuditLog[]
  numberSequences  NumberSequence[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid()) @db.Char(36)
  companyId String   @map("company_id") @db.Char(36)
  name      String   @db.VarChar(160)
  code      String   @db.VarChar(20)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(30)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id])
  orders             ServiceOrder[]
  cashRegisters      CashRegister[]
  servicePrices      ServicePrice[]
  employees          Employee[]
  userBranches       UserBranch[]
  serviceCategories  ServiceCategory[]
  operationalAreas   OperationalArea[]
  pointsOfSale       PointOfSale[]
  productCategories  ProductCategory[]
  products           Product[]
  expenses           Expense[]
  inventoryMovements InventoryMovement[]
  inventoryCounts    InventoryCount[]
  purchaseOrders     PurchaseOrder[]
  supplierInvoices   SupplierInvoice[]
  supplierPayments   SupplierPayment[]
  modules            BranchModule[]
  productBranches    ProductBranch[]

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("branches")
}

model BranchModule {
  id        String             @id @default(uuid()) @db.Char(36)
  companyId String             @map("company_id") @db.Char(36)
  branchId  String             @map("branch_id") @db.Char(36)
  module    BusinessModuleType
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, module])
  @@index([companyId, branchId, enabled])
  @@map("branch_modules")
}

model User {
  id               String           @id @default(uuid()) @db.Char(36)
  companyId        String           @map("company_id") @db.Char(36)
  username         String           @db.VarChar(80)
  email            String?          @db.VarChar(180)
  passwordHash     String           @map("password_hash") @db.VarChar(255)
  fullName         String           @map("full_name") @db.VarChar(160)
  status           UserStatus       @default(ACTIVE)
  branchAccessMode BranchAccessMode @default(ASSIGNED) @map("branch_access_mode")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  isPlatformAdmin  Boolean          @default(false) @map("is_platform_admin")

  company              Company               @relation(fields: [companyId], references: [id])
  userRoles            UserRole[]
  userBranches         UserBranch[]
  cashSessions         CashSession[]
  employee             Employee?
  auditLogs            AuditLog[]            @relation("AuditUser")
  creditAuthorizations CreditAuthorization[] @relation("CreditAuthorizationUser")

  issuedCreditNotes CreditNote[] @relation("CreditNoteIssuedBy")

  collectionActivitiesCreated  CustomerCollectionActivity[] @relation("CustomerCollectionCreatedBy")
  collectionActivitiesResolved CustomerCollectionActivity[] @relation("CustomerCollectionResolvedBy")

  @@unique([companyId, username])
  @@unique([companyId, email])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Char(36)
  code        String           @unique @db.VarChar(60)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  active      Boolean          @default(true)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(140)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserBranch {
  userId    String   @map("user_id") @db.Char(36)
  branchId  String   @map("branch_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Customer {
  id            String       @id @default(uuid()) @db.Char(36)
  companyId     String       @map("company_id") @db.Char(36)
  type          CustomerType @default(GENERAL)
  displayName   String       @map("display_name") @db.VarChar(160)
  legalName     String?      @map("legal_name") @db.VarChar(200)
  phone         String?      @db.VarChar(30)
  email         String?      @db.VarChar(180)
  taxId         String?      @map("tax_id") @db.VarChar(50)
  creditEnabled Boolean      @default(false) @map("credit_enabled")
  creditLimit   Decimal      @default(0) @map("credit_limit") @db.Decimal(14, 2)
  creditDays    Int          @default(0) @map("credit_days")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  priceLevelId  String?      @map("price_level_id") @db.Char(36)
  priceLevel    PriceLevel?  @relation(fields: [priceLevelId], references: [id], onDelete: SetNull)

  company              Company                      @relation(fields: [companyId], references: [id])
  vehicles             Vehicle[]
  orders               ServiceOrder[]
  invoices             Invoice[]
  creditAuthorizations CreditAuthorization[]
  collectionActivities CustomerCollectionActivity[]
  posAccounts          PosAccount[]
  posMovements         PosMovement[]

  @@index([companyId, displayName])
  @@index([companyId, phone])
  @@index([companyId, priceLevelId])
  @@map("customers")
}

enum CustomerCollectionContactType {
  PHONE
  WHATSAPP
  EMAIL
  SMS
  IN_PERSON
  OTHER
}

enum BranchAccessMode {
  ALL
  ASSIGNED
}

enum CustomerCollectionResult {
  CONTACTED
  NO_ANSWER
  PROMISE_TO_PAY
  PAYMENT_REPORTED
  DISPUTED
  FOLLOW_UP_REQUIRED
  OTHER
}

model CustomerCollectionActivity {
  id          String  @id @default(uuid()) @db.Char(36)
  companyId   String  @map("company_id") @db.Char(36)
  customerId  String  @map("customer_id") @db.Char(36)
  createdById String? @map("created_by_id") @db.Char(36)

  contactType CustomerCollectionContactType @map("contact_type")
  result      CustomerCollectionResult
  notes       String                        @db.Text

  nextFollowUpAt      DateTime? @map("next_follow_up_at")
  promisedPaymentDate DateTime? @map("promised_payment_date")
  promisedAmount      Decimal?  @map("promised_amount") @db.Decimal(14, 2)

  followUpResolvedAt   DateTime? @map("follow_up_resolved_at")
  followUpResolvedById String?   @map("follow_up_resolved_by_id") @db.Char(36)
  followUpResolution   String?   @map("follow_up_resolution") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdBy          User? @relation("CustomerCollectionCreatedBy", fields: [createdById], references: [id])
  followUpResolvedBy User? @relation("CustomerCollectionResolvedBy", fields: [followUpResolvedById], references: [id])

  @@index([companyId, createdAt])
  @@index([customerId, createdAt])
  @@index([companyId, nextFollowUpAt])
  @@index([companyId, promisedPaymentDate])
  @@map("customer_collection_activities")
}

model VehicleType {
  id       String         @id @default(uuid()) @db.Char(36)
  code     String         @unique @db.VarChar(40)
  name     String         @db.VarChar(100)
  active   Boolean        @default(true)
  vehicles Vehicle[]
  prices   ServicePrice[]

  @@map("vehicle_types")
}

model VehicleBrand {
  id       String         @id @default(uuid()) @db.Char(36)
  name     String         @unique @db.VarChar(100)
  models   VehicleModel[]
  vehicles Vehicle[]

  @@map("vehicle_brands")
}

model VehicleModel {
  id       String       @id @default(uuid()) @db.Char(36)
  brandId  String       @map("brand_id") @db.Char(36)
  name     String       @db.VarChar(100)
  brand    VehicleBrand @relation(fields: [brandId], references: [id])
  vehicles Vehicle[]

  @@unique([brandId, name])
  @@map("vehicle_models")
}

model Vehicle {
  id            String   @id @default(uuid()) @db.Char(36)
  customerId    String?  @map("customer_id") @db.Char(36)
  vehicleTypeId String   @map("vehicle_type_id") @db.Char(36)
  brandId       String?  @map("brand_id") @db.Char(36)
  modelId       String?  @map("model_id") @db.Char(36)
  plate         String?  @db.VarChar(30)
  color         String?  @db.VarChar(60)
  description   String   @db.VarChar(180)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer    Customer?      @relation(fields: [customerId], references: [id])
  vehicleType VehicleType    @relation(fields: [vehicleTypeId], references: [id])
  brand       VehicleBrand?  @relation(fields: [brandId], references: [id])
  model       VehicleModel?  @relation(fields: [modelId], references: [id])
  orders      ServiceOrder[]

  @@index([plate])
  @@index([customerId])
  @@map("vehicles")
}

model Employee {
  id             String   @id @default(uuid()) @db.Char(36)
  companyId      String   @map("company_id") @db.Char(36)
  userId         String?  @unique @map("user_id") @db.Char(36)
  branchId       String   @map("branch_id") @db.Char(36)
  employeeNo     String   @map("employee_no") @db.VarChar(30)
  fullName       String   @map("full_name") @db.VarChar(160)
  phone          String?  @db.VarChar(30)
  jobPosition    String?  @map("job_position") @db.VarChar(100)
  canOperateCash Boolean  @default(false) @map("can_operate_cash")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company           Company                  @relation(fields: [companyId], references: [id])
  branch            Branch                   @relation(fields: [branchId], references: [id])
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItems        ServiceOrderItem[]
  commissionRules   EmployeeCommissionRule[]
  cashSessions      CashSession[]
  requestedExpenses Expense[]

  @@unique([companyId, employeeNo])
  @@index([branchId, active])
  @@map("employees")
}

model ServiceCategory {
  id                String           @id @default(uuid()) @db.Char(36)
  companyId         String           @map("company_id") @db.Char(36)
  branchId          String           @map("branch_id") @db.Char(36)
  operationalAreaId String?          @map("operational_area_id") @db.Char(36)
  code              String           @db.VarChar(40)
  name              String           @db.VarChar(100)
  active            Boolean          @default(true)
  company           Company          @relation(fields: [companyId], references: [id])
  branch            Branch           @relation(fields: [branchId], references: [id])
  operationalArea   OperationalArea? @relation(fields: [operationalAreaId], references: [id])
  services          Service[]

  @@unique([companyId, code])
  @@index([branchId, active])
  @@index([operationalAreaId, active])
  @@map("service_categories")
}

model Service {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @map("company_id") @db.Char(36)
  categoryId  String   @map("category_id") @db.Char(36)
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(140)
  description String?  @db.VarChar(255)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company         Company                  @relation(fields: [companyId], references: [id])
  category        ServiceCategory          @relation(fields: [categoryId], references: [id])
  prices          ServicePrice[]
  orderItems      ServiceOrderItem[]
  commissionRules EmployeeCommissionRule[]

  @@unique([companyId, code])
  @@index([companyId, categoryId, active])
  @@map("services")
}

model ServicePrice {
  id            String    @id @default(uuid()) @db.Char(36)
  serviceId     String    @map("service_id") @db.Char(36)
  vehicleTypeId String    @map("vehicle_type_id") @db.Char(36)
  branchId      String    @map("branch_id") @db.Char(36)
  price         Decimal   @db.Decimal(14, 2)
  taxable       Boolean   @default(false)
  active        Boolean   @default(true)
  validFrom     DateTime  @default(now()) @map("valid_from")
  validTo       DateTime? @map("valid_to")

  service     Service     @relation(fields: [serviceId], references: [id])
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])

  @@index([serviceId, vehicleTypeId, branchId, active])
  @@map("service_prices")
}

model EmployeeCommissionRule {
  id         String         @id @default(uuid()) @db.Char(36)
  employeeId String         @map("employee_id") @db.Char(36)
  serviceId  String         @map("service_id") @db.Char(36)
  type       CommissionType
  value      Decimal        @default(0) @db.Decimal(14, 4)
  active     Boolean        @default(true)
  validFrom  DateTime       @default(now()) @map("valid_from")
  validTo    DateTime?      @map("valid_to")

  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@index([employeeId, serviceId, active])
  @@map("employee_commission_rules")
}

model ServiceOrder {
  id                  String                 @id @default(uuid()) @db.Char(36)
  branchId            String                 @map("branch_id") @db.Char(36)
  customerId          String?                @map("customer_id") @db.Char(36)
  customerAlias       String                 @map("customer_alias") @db.VarChar(160)
  vehicleId           String                 @map("vehicle_id") @db.Char(36)
  orderNumber         String                 @unique @map("order_number") @db.VarChar(30)
  operationalStatus   OrderOperationalStatus @default(RECEIVED) @map("operational_status")
  financialStatus     OrderFinancialStatus   @default(PENDING) @map("financial_status")
  qrToken             String                 @unique @map("qr_token") @db.VarChar(100)
  notes               String?                @db.Text
  entryAt             DateTime               @default(now()) @map("entry_at")
  servicesCompletedAt DateTime?              @map("services_completed_at")
  paidAt              DateTime?              @map("paid_at")
  deliveredAt         DateTime?              @map("delivered_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  branch              Branch               @relation(fields: [branchId], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id])
  vehicle             Vehicle              @relation(fields: [vehicleId], references: [id])
  items               ServiceOrderItem[]
  invoice             Invoice?
  events              OrderEvent[]
  checklistItems      OrderChecklistItem[]
  observations        OrderNote[]
  printLogs           TicketPrintLog[]
  posMovements        PosMovement[]
  posAccounts         PosAccount[]
  creditAuthorization CreditAuthorization?

  @@index([branchId, operationalStatus, entryAt])
  @@index([vehicleId, createdAt])
  @@map("service_orders")
}

model ServiceOrderItem {
  id                  String          @id @default(uuid()) @db.Char(36)
  serviceOrderId      String          @map("service_order_id") @db.Char(36)
  itemType            OrderItemType   @map("item_type")
  serviceId           String?         @map("service_id") @db.Char(36)
  productId           String?         @map("product_id") @db.Char(36)
  pointOfSaleId       String?         @map("point_of_sale_id") @db.Char(36)
  employeeId          String?         @map("employee_id") @db.Char(36)
  descriptionSnapshot String          @map("description_snapshot") @db.VarChar(180)
  quantity            Decimal         @default(1) @db.Decimal(12, 3)
  unitPrice           Decimal         @map("unit_price") @db.Decimal(14, 2)
  taxRate             Decimal         @default(0) @map("tax_rate") @db.Decimal(7, 4)
  taxAmount           Decimal         @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal           Decimal         @map("line_total") @db.Decimal(14, 2)
  commissionType      CommissionType? @map("commission_type")
  commissionValue     Decimal?        @map("commission_value") @db.Decimal(14, 4)
  commissionAmount    Decimal?        @map("commission_amount") @db.Decimal(14, 2)
  status              OrderItemStatus @default(ACTIVE)
  voidReason          String?         @map("void_reason") @db.VarChar(255)
  createdAt           DateTime        @default(now()) @map("created_at")
  voidedAt            DateTime?       @map("voided_at")

  order        ServiceOrder  @relation(fields: [serviceOrderId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  pointOfSale  PointOfSale?  @relation(fields: [pointOfSaleId], references: [id])
  employee     Employee?     @relation(fields: [employeeId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([serviceOrderId, status])
  @@map("service_order_items")
}

model CreditAuthorization {
  id             String                    @id @default(uuid()) @db.Char(36)
  orderId        String                    @unique @map("order_id") @db.Char(36)
  customerId     String                    @map("customer_id") @db.Char(36)
  authorizedById String?                   @map("authorized_by_id") @db.Char(36)
  amount         Decimal                   @db.Decimal(14, 2)
  creditDays     Int                       @map("credit_days")
  dueDate        DateTime?                 @map("due_date")
  status         CreditAuthorizationStatus @default(APPROVED)
  authorizedAt   DateTime                  @default(now()) @map("authorized_at")
  cancelledAt    DateTime?                 @map("cancelled_at")
  notes          String?                   @db.VarChar(255)

  order        ServiceOrder @relation(fields: [orderId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  authorizedBy User?        @relation("CreditAuthorizationUser", fields: [authorizedById], references: [id])

  @@index([customerId, status, authorizedAt])
  @@index([authorizedById, authorizedAt])
  @@map("credit_authorizations")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Char(36)
  orderId       String        @unique @map("order_id") @db.Char(36)
  customerId    String?       @map("customer_id") @db.Char(36)
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(30)
  status        InvoiceStatus @default(ISSUED)
  subtotal      Decimal       @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  balance       Decimal       @db.Decimal(14, 2)
  issuedAt      DateTime      @default(now()) @map("issued_at")
  dueDate       DateTime?     @map("due_date")
  createdAt     DateTime      @default(now()) @map("created_at")

  order       ServiceOrder        @relation(fields: [orderId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  creditNotes CreditNote[]
  allocations PaymentAllocation[]

  @@index([customerId, status, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Char(36)
  invoiceId   String  @map("invoice_id") @db.Char(36)
  orderItemId String  @map("order_item_id") @db.Char(36)
  description String  @db.VarChar(180)
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(14, 2)

  invoice   Invoice          @relation(fields: [invoiceId], references: [id])
  orderItem ServiceOrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([invoiceId, orderItemId])
  @@map("invoice_items")
}

model CreditNote {
  id           String           @id @default(uuid()) @db.Char(36)
  companyId    String           @map("company_id") @db.Char(36)
  invoiceId    String           @map("invoice_id") @db.Char(36)
